{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "$app/types"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "tests",
    "e2e",
    "*.ts",
    "*.js"
  ],
  "exclude": [
    "src/service-worker"
  ]
}
