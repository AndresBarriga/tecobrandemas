{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "a-su-precio",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// Dominio propio (se añadió desde el panel): declarado aquí para que un despliegue no lo elimine. Sin www: lo redirige una regla de Cloudflare.
	"routes": [{ "pattern": "asuprecio.com", "custom_domain": true }],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Sin ids: wrangler crea los recursos la primera vez que se despliega.
	"d1_databases": [
		{ "binding": "CALLEJERO", "database_name": "a-su-precio-callejero" },
		{ "binding": "DB", "database_name": "a-su-precio-registro", "migrations_dir": "migrations" }
	],
	"r2_buckets": [
		{ "binding": "TARJETAS", "bucket_name": "a-su-precio-tarjetas" },
		{ "binding": "MAPA", "bucket_name": "a-su-precio-mapa" }
	],
	// Sin registros de invocación: guardarían la URL de cada petición (con ?barrio= o el id de /t/…) durante 3-7 días.
	// Los registros que escriba el código siguen disponibles; hoy el código no escribe ninguno.
	"observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
